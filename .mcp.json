{
  "mcpServers": {
    "coros": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/cygnusb/coros-mcp.git",
        "coros-mcp",
        "serve"
      ],
      "env": {
        "COROS_MCP_TOOLSET": "readonly"
      }
    },
    "garmin": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/Taxuspt/garmin_mcp",
        "garmin-mcp"
      ]
    }
  }
}
