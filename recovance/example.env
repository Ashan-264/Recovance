# Recovance environment variables
# Copy this file to .env.local (which is gitignored) and fill in your values:
#   cp example.env .env.local

# ── Strava ────────────────────────────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain must match your host (e.g. "localhost" in dev).
# The OAuth callback used by this app is: <base-url>/api/auth/strava/callback
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Optional fallback: a manually generated access token (expires every 6 hours).
# Prefer connecting via the /connect page instead. NOTE: NEXT_PUBLIC_ vars are
# bundled into the client and visible to anyone loading the site.
#NEXT_PUBLIC_STRAVA_API_TOKEN=

# ── Oura ──────────────────────────────────────────────────────────────────
# OAuth app: https://cloud.ouraring.com/oauth/applications
# Callback URL to register: <base-url>/api/auth/oura/callback
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret

# Optional fallback: personal access token from
# https://cloud.ouraring.com/personal-access-tokens
#OURA_API_TOKEN=your_oura_personal_access_token

# ── WHOOP ─────────────────────────────────────────────────────────────────
# Create an app at https://developer.whoop.com (Developer Dashboard).
# Redirect URI to register: <base-url>/api/auth/whoop/callback
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret

# ── COROS ─────────────────────────────────────────────────────────────────
# COROS has no public OAuth API; the app signs in with your COROS account
# credentials (same login as the COROS app / training hub). Prefer connecting
# on the /connect page — these env vars are an optional server-side fallback.
# Region codes: us, eu, asia
#COROS_EMAIL=your_coros_email
#COROS_PASSWORD=your_coros_password
#COROS_REGION=us

# ── Mapbox (dashboard activity maps) ──────────────────────────────────────
# Public token from https://account.mapbox.com/access-tokens
#NEXT_PUBLIC_MAP_BOX_API=pk.your_mapbox_public_token

# ── Database (self-hosted Postgres + Prisma) ──────────────────────────────
# Start it with:  docker compose up -d
# Host port is 5433 by default so it will not clash with another local
# Postgres on 5432. Override POSTGRES_USER/PASSWORD/DB/PORT for the container.
DATABASE_URL=postgresql://recovance:recovance@localhost:5433/recovance?schema=public

# ── App ───────────────────────────────────────────────────────────────────
# Only needed when the app runs behind a proxy and the request origin does
# not match the public URL used for OAuth redirects.
# APP_BASE_URL=http://localhost:3000
